# .env.production（生产环境）
# ⚠️ 不要把任何真实密钥提交到仓库。

# 生产后端 API 地址（示例）
VITE_API_BASE=/

# 是否开启 Mock（生产环境应为 false）
VITE_USE_MOCK=false

# 旧功能保留字段（如不需要可删除）
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1