# .env.development（开发环境）
# ⚠️ 不要把任何真实密钥提交到仓库。

# 后端 API 地址（示例）
VITE_API_BASE=http://localhost:9090

# 仅用于前端联调：开启 Mock 登录/注册
VITE_USE_MOCK=false

# （保留字段：如果你还要用到旧的 OpenAI 功能，请在本机环境变量里注入，不要写进项目）
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1